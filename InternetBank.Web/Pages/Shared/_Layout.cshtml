<!DOCTYPE html>
<html lang="ru">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - InvestBank</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/variables.css">
    <link rel="stylesheet" href="~/styles.css">

</head>

<body>
    <header class="header">
        <div class="container">
            <div class="navbar">
                <div class="logo">InvestBank</div>
                <div class="nav-links">
                    @if (!string.IsNullOrEmpty(Context.Session.GetString("UserId")))
                    {
                        var firstName = Context.Session.GetString("UserFirstName");
                        <span>Привет, @firstName!</span>
                        <a href="/Accounts" class="btn-outline">Мои счета</a>
                        <a href="/Logout" class="btn-outline">Выйти</a>
                    }
                    else
                    {
                        <a href="/Login" class="btn-outline">Вход</a>
                        <a href="/Register" class="btn-primary">Регистрация</a>
                    }
                </div>
            </div>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="container">
            <div class="footer-content">
                <div>© 2026 InvestBank. Все права защищены.</div>
                <div>📞 375-29-123-45-67</div>
                <div>✉️ support@InvestBank.ru</div>
            </div>
            <div class="footer-copyright">Интернет-банк Лицензия ЦБ РБ № 1234</div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>