@using InternetBank.Web.ViewModels
@model AccountListViewModel
@{
    ViewData["Title"] = "Мои счета";
}

<div class="container" style="max-width: 900px; margin-top: 30px;">
    <h2>Мои счета</h2>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <a href="/Accounts/Open" class="btn-primary">Открыть счёт</a>
    </div>

    <form method="get" class="filter-form row g-3 mb-4">
        <div class="col-md-4">
            <label class="form-label">Валюта</label>
            <select name="currency" class="form-select">
                @foreach (var item in Model.Currencies)
                {
                    <option value="@item.Value" selected="@(item.Value == Model.CurrencyFilter)">@item.Text</option>
                }
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label">Статус</label>
            <select name="isActive" class="form-select">
                <option value="">Все</option>
                <option value="true" selected="@(Model.IsActiveFilter == true)">Активные</option>
                <option value="false" selected="@(Model.IsActiveFilter == false)">Закрытые</option>
            </select>
        </div>
        <div class="col-md-4 d-flex align-items-end">
            <button type="submit" class="btn-outline-primary">Применить</button>
            <a href="/Accounts" class="btn-outline-secondary ms-2">Сбросить</a>
        </div>
    </form>

    @if (!Model.Accounts.Any())
    {
        <p>У вас пока нет счетов.</p>
    }
    else
    {
        <div class="row">
            @foreach (var account in Model.Accounts)
            {
                <div class="col-md-6 mb-3">
                    <div class="account-card">
                        <div class="card-body">
                            <h5>Счёт № @account.AccountNumber</h5>
                            <p>
                                <strong>Валюта:</strong> @account.Currency<br>
                                <strong>Баланс:</strong> @account.Balance.ToString("N2")<br>
                                <strong>Статус:</strong> @(account.IsActive ? "Активен" : "Закрыт")<br>
                                <strong>Открыт:</strong> @account.CreatedAt.ToShortDateString()
                            </p>
                            <a href="/Accounts/Details/@account.Id" class="btn-outline-primary">Детали</a>
                            @if (account.IsActive)
                            {
                                <form method="post" action="/Accounts/Close/@account.Id" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-outline-danger"
                                            onclick="return confirm('Закрыть счёт?')">Закрыть</button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>